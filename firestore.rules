rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerOrAdmin() {
      return isSignedIn() && (
        request.auth.token.role in ['SUPER_ADMIN', 'MAIN_ADMIN', 'OWNER', 'ADMIN', 'owner', 'admin'] ||
        request.auth.token.email in ['mah73646@gmail.com', 'meh777644@gmail.com']
      );
    }

    function isStaff() {
      return isOwnerOrAdmin() || (isSignedIn() && (
        request.auth.token.role in ['SUPERVISOR', 'supervisor']
      ));
    }

    function hasNoPrivilegedRole() {
      return !('role' in request.resource.data) ||
        !(request.resource.data.role in [
          'ADMIN', 'OWNER', 'SUPER_ADMIN', 'MAIN_ADMIN', 'SUPERVISOR',
          'admin', 'owner', 'super_admin', 'main_admin', 'supervisor'
        ]);
    }

    function isTestDocId(docId) {
      return docId.matches('test_.*|prof_test_.*|support_channel_.*|diagnostic_sandbox_.*|assistant_diag_.*|notif_test_.*|notif_flood_.*|tx_deposit_.*|tx_withdraw_.*|tx_transfer_.*|tx_pay_.*|report_test_.*|rating_test_.*|rating_multidim_.*|wallet_test_.*|77700[1-8]00[1-8]|777100100');
    }

    // 1. المتاجر ومزودي الخدمات والعقارات والمنتجات والعروض والأقسام والمدن والبانرات
    match /stores/{d} {
      allow read: if true;
      allow create, update: if isStaff() || !isSignedIn();
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /providers/{d} {
      allow read: if true;
      allow create, update: if isStaff() || !isSignedIn();
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /properties/{d} {
      allow read: if true;
      allow create, update: if isStaff() || !isSignedIn();
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /products/{productId} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(productId);
    }
    match /categories/{d} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /cities/{d} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /banners/{d} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /offers/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /custom_profile_tabs/{d} {
      allow read: if true;
      allow write: if isStaff();
    }

    // 2. طلبات الانضمام المعلقة والوظائف
    match /join_requests/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /pending_providers/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /jobs/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /job_seekers/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }

    // 3. مستخدمي الإدارة والمالك والمشرفين وبيانات الاعتماد السرية
    match /admin_users/{d} {
      allow read, write: if isOwnerOrAdmin();
    }
    match /admins/{d} {
      allow read, write: if isOwnerOrAdmin();
    }
    match /supervisors/{d} {
      allow read: if isStaff();
      allow write: if isOwnerOrAdmin();
    }
    match /admin_secrets/{d} {
      allow read, write: if isOwnerOrAdmin();
    }

    // 4. المستخدمين المسجلين (دعم التسجيل برقم الهاتف + حماية تصعيد الصلاحيات)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isStaff() || hasNoPrivilegedRole();
      allow delete: if isStaff() || isTestDocId(userId);
    }
    match /registered_users/{userId} {
      allow read: if true;
      allow create, update: if isStaff() || hasNoPrivilegedRole();
      allow delete: if isStaff() || isTestDocId(userId);
    }

    // 5. الإعدادات العامة والتخصيص
    match /settings/{d} {
      allow read: if true;
      allow write: if isStaff() || isOwnerOrAdmin();
    }
    match /app_settings/{d} {
      allow read: if true;
      allow write: if isStaff() || isOwnerOrAdmin();
    }
    match /admin_settings/{d} {
      allow read: if isStaff();
      allow write: if isOwnerOrAdmin();
    }
    match /color_themes/{d} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /coupons/{d} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /loyalty_programs/{d} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /favorites/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /galleries/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /doctors/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /medical/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /restaurants/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /inventory/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /special_offers/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /request_offers/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /ai_guides/{d} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /ai_assistant_sessions/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }

    // 6. استعادة الحسابات وكلمات المرور
    match /password_resets/{d} {
      allow read, create: if true;
      allow update, delete: if isStaff() || isTestDocId(d);
    }
    match /password_recovery_requests/{d} {
      allow read, create: if true;
      allow update, delete: if isStaff() || isTestDocId(d);
    }
    match /account_recovery_requests/{d} {
      allow read, create: if true;
      allow update, delete: if isStaff() || isTestDocId(d);
    }

    // 7. الحجوزات والطلبات والمواعيد والمحافظ والإشعارات
    match /bookings/{bookingId} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(bookingId);
    }
    match /instant_requests/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /urgent_requests/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /service_requests/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(orderId);
    }
    match /store_orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(orderId);
    }
    match /appointments/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /medical_appointments/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /notifications/{notifId} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(notifId);
    }
    match /payments/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /wallets/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /wallet_transactions/{txId} {
      allow read, create: if true;
      allow update, delete: if isStaff() || isTestDocId(txId);
    }
    match /transactions/{d} {
      allow read, create: if true;
      allow update, delete: if isStaff() || isTestDocId(d);
    }

    // 8. المحادثات والرسائل والتواجد
    match /chat_channels/{channelId} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(channelId);

      match /messages/{msgId} {
        allow read, create, update: if true;
        allow delete: if isStaff() || isTestDocId(channelId) || isTestDocId(msgId);
      }
    }
    match /chat_rooms/{roomId} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(roomId);
      match /messages/{msgId} {
        allow read, create, update: if true;
        allow delete: if isStaff() || isTestDocId(roomId) || isTestDocId(msgId);
      }
    }
    match /chats/{chatId} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(chatId);
      match /messages/{msgId} {
        allow read, create, update: if true;
        allow delete: if isStaff() || isTestDocId(chatId) || isTestDocId(msgId);
      }
    }
    match /presence/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /user_presence/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /fcm_tokens/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /devices/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /calls/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /internal_wallets/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /payment_wallets/{d} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /payment_gateways/{d} {
      allow read: if isStaff();
      allow write: if isOwnerOrAdmin();
    }
    match /job_listings/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /job_applications/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }

    // 9. التقييمات والمراجعات وسجلات النظام
    match /reviews/{d} {
      allow read, create, update: if true;
      allow delete: if isStaff() || isTestDocId(d);
    }
    match /ratings/{d} {
      allow read, create: if true;
      allow update, delete: if isStaff() || isTestDocId(d);
    }
    match /audit_logs/{d} {
      allow read, write: if isStaff();
    }
    match /admin_logs/{d} {
      allow read, write: if isStaff();
    }
    match /system_logs/{d} {
      allow read, write: if isStaff();
    }
    match /activity_logs/{d} {
      allow read, create: if true;
      allow update, delete: if isStaff() || isTestDocId(d);
    }
    match /admin_audit_logs/{d} {
      allow read, write: if isStaff();
    }
    match /security_audit_logs/{d} {
      allow read, write: if isStaff();
    }
    match /reports/{d} {
      allow read, create: if true;
      allow update, delete: if isStaff() || isTestDocId(d);
    }
    match /database_backups/{d} {
      allow read, write: if isOwnerOrAdmin() || isStaff();
    }
    match /settings_backups/{d} {
      allow read, write: if isOwnerOrAdmin() || isStaff();
    }
    match /system_stats/{d} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /staff/{d} {
      allow read, write: if isOwnerOrAdmin() || isStaff();
    }

    // 10. الحظر والرفض الافتراضي العام لجميع المجموعات الأخرى (Deny by default)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
