# ==========================================
# Android & AI Studio Master GitIgnore
# ==========================================

# Built application files & artifacts
*.apk
*.aab
*.ap_
*.dex
app-debug.apk

# Gradle build cache & intermediate files
.gradle/
build/
app/build/
**/build/
.kotlin/
.build-outputs/

# AI Studio workspace cache & temporary user assets
.aistudio/
public/
clean_and_copy.sh

# Keystore & Signing files (DO NOT COMMIT SECRETS)
*.keystore
*.jks
*.base64
my-release-key.jks
debug.keystore

# Local configuration & environment variables
local.properties
.env
.env.*
!.env.example

# IDE files (Android Studio / IntelliJ / Eclipse)
.idea/
*.iml
.DS_Store
Thumbs.db
captures/
.externalNativeBuild/
.cxx/

# ==========================================
# Staged Sync Batches for AI Studio -> GitHub
# Batch 4: UI ViewModels, Core UI, Home, Map, Chat, Bookings, Notifications, Urgent (~151 files)
# (Admin, Dashboard, Register, Entities, Owner will be enabled in Batch 5)
# ==========================================
app/src/main/java/com/serviseyem/ui/screens/admin/
app/src/main/java/com/serviseyem/ui/screens/dashboard/
app/src/main/java/com/serviseyem/ui/screens/register/
app/src/main/java/com/serviseyem/ui/screens/entities/
app/src/main/java/com/serviseyem/ui/screens/owner/
