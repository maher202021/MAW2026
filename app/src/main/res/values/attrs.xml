<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ═══════════════════════════════════════ -->
    <!-- YEMEN SERVICES CUSTOM THEME ATTRIBUTES   -->
    <!-- ═══════════════════════════════════════ -->
    <declare-styleable name="YemenTheme">
        <attr name="ysColorPrimary" format="color" />
        <attr name="ysColorSecondary" format="color" />
        <attr name="ysColorAccent" format="color" />
        <attr name="ysColorBackground" format="color" />
        <attr name="ysColorSurface" format="color" />
        <attr name="ysColorBorder" format="color" />
        <attr name="ysColorTextPrimary" format="color" />
        <attr name="ysColorTextSecondary" format="color" />
        <attr name="ysColorSuccess" format="color" />
        <attr name="ysColorWarning" format="color" />
        <attr name="ysColorError" format="color" />
    </declare-styleable>

    <!-- ═══════════════════════════════════════ -->
    <!-- CUSTOM CARD ATTRIBUTES                   -->
    <!-- ═══════════════════════════════════════ -->
    <declare-styleable name="YemenCard">
        <attr name="ysCardElevation" format="dimension" />
        <attr name="ysCardRadius" format="dimension" />
        <attr name="ysCardBorderWidth" format="dimension" />
        <attr name="ysCardBorderColor" format="color" />
        <attr name="ysCardBackground" format="color" />
    </declare-styleable>

    <!-- ═══════════════════════════════════════ -->
    <!-- CUSTOM BUTTON ATTRIBUTES                 -->
    <!-- ═══════════════════════════════════════ -->
    <declare-styleable name="YemenButton">
        <attr name="ysButtonStyle" format="enum">
            <enum name="primary" value="0" />
            <enum name="secondary" value="1" />
            <enum name="outlined" value="2" />
            <enum name="text" value="3" />
        </attr>
        <attr name="ysButtonSize" format="enum">
            <enum name="small" value="0" />
            <enum name="medium" value="1" />
            <enum name="large" value="2" />
        </attr>
    </declare-styleable>

</resources>
